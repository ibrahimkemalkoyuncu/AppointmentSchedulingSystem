@model AppointmentSchedulingSystem.Models.Appointment

@{
    ViewData["Title"] = "Doktor Muayene Ekranı";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5 border-bottom pb-2">Muayene Ekranı</h1>
        </div>
    </div>

    <div class="row">
        <!-- Sol Kolon: Hasta Bilgileri ve Geçmiş -->
        <div class="col-md-4">
            <!-- Hasta Kartı -->
            <div class="card mb-3">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Hasta Bilgileri</h5>
                </div>
                <div class="card-body">
                    <h4 class="card-title">@Model.Patient?.Name @Model.Patient?.Surname</h4>
                    <p class="card-text"><strong>TC Kimlik:</strong> @Model.Patient?.IdentityNumber</p>
                    <p class="card-text"><strong>Telefon:</strong> @Model.Patient?.PhoneNumber</p>
                    <p class="card-text"><strong>E-Posta:</strong> @Model.Patient?.Email</p>
                </div>
            </div>

            <!-- Randevu Detay -->
             <div class="card mb-3">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Randevu Detayları</h5>
                </div>
                <div class="card-body">
                    <p><strong>Tarih:</strong> @Model.AppointmentDate.ToString("dd.MM.yyyy")</p>
                    <p><strong>Saat:</strong> @Model.AppointmentDate.ToString("HH:mm") - @Model.EndDate.ToString("HH:mm")</p>
                    <p><strong>Doktor:</strong> @Model.Doctor?.Name @Model.Doctor?.Surname</p>
                </div>
            </div>

            <!-- Tıbbi Geçmiş -->
            <div class="card">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Tıbbi Geçmiş</h5>
                    <span class="badge bg-light text-dark">@((ViewBag.PatientHistory as List<AppointmentSchedulingSystem.Models.Appointment>)?.Count ?? 0)</span>
                </div>
                <div class="list-group list-group-flush" style="max-height: 400px; overflow-y: auto;">
                    @if (ViewBag.PatientHistory != null)
                    {
                        foreach (var hist in (List<AppointmentSchedulingSystem.Models.Appointment>)ViewBag.PatientHistory)
                        {
                            <div class="list-group-item">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">@hist.AppointmentDate.ToString("dd.MM.yyyy")</h6>
                                    <small>@hist.Doctor?.Name @hist.Doctor?.Surname</small>
                                </div>
                                <p class="mb-1 text-truncate" title="@hist.Diagnosis"><strong>Tanı:</strong> @hist.Diagnosis</p>
                                <small class="text-muted text-truncate d-block" title="@hist.Treatment"><strong>Tedavi:</strong> @hist.Treatment</small>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Sağ Kolon: Muayene Notları -->
        <div class="col-md-8">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Tıbbi Değerlendirme</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Consultation">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group mb-3">
                            <label asp-for="Complaint" class="form-label fw-bold">Hasta Şikayeti / Anamnez</label>
                            <textarea asp-for="Complaint" class="form-control" rows="3" placeholder="Hastanın geliş şikayeti ve öyküsü..."></textarea>
                            <span asp-validation-for="Complaint" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Diagnosis" class="form-label fw-bold">Tanı / Teşhis</label>
                            <input asp-for="Diagnosis" class="form-control" placeholder="ICD kodu veya tanı açıklaması..." />
                            <span asp-validation-for="Diagnosis" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Treatment" class="form-label fw-bold">Tedavi / Reçete / Öneriler</label>
                            <textarea asp-for="Treatment" class="form-control" rows="4" placeholder="İlaçlar, tedavi planı ve öneriler..."></textarea>
                            <span asp-validation-for="Treatment" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="PrintPrescription" asp-route-id="@Model.Id" target="_blank" class="btn btn-warning me-md-2">🖨️ Reçete Yazdır</a>
                            <a asp-action="Index" class="btn btn-secondary me-md-2">Vazgeç</a>
                            <button type="submit" class="btn btn-success btn-lg">Muayeneyi Tamamla ve Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
