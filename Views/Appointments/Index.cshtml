@model IEnumerable<AppointmentSchedulingSystem.Models.Appointment>

@{
    ViewData["Title"] = "Randevu Listesi";
}

<h1>Randevu Yönetimi</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Yeni Randevu Oluştur</a>
</p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Tarih & Saat</th>
            <th>Bitiş</th>
            <th>Hasta</th>
            <th>Doktor</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
             <td>
                @item.AppointmentDate.ToString("dd.MM.yyyy HH:mm")
            </td>
            <td>
                @item.EndDate.ToString("HH:mm")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Patient.Name) @Html.DisplayFor(modelItem => item.Patient.Surname)
                <br/>
                <small class="text-muted">@Html.DisplayFor(modelItem => item.Patient.IdentityNumber)</small>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Doctor.Name) @Html.DisplayFor(modelItem => item.Doctor.Surname)
                <br/>
                <small class="text-muted">@Html.DisplayFor(modelItem => item.Doctor.Specialization)</small>
            </td>
            <td>
                @{
                    var badgeClass = "bg-secondary";
                    if (item.Status == "Beklemede") badgeClass = "bg-warning text-dark";
                    else if (item.Status == "Tamamlandı") badgeClass = "bg-success";
                    else if (item.Status == "İptal Edildi") badgeClass = "bg-danger";
                }
                <span class="badge @badgeClass">@item.Status</span>
            </td>
            <td>
                <div class="btn-group" role="group">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Düzenle">Düzenle</a>

                    @if(item.Status == "Beklemede")
                    {
                         <form asp-action="Complete" asp-route-id="@item.Id" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-success" title="Tamamla">✔</button>
                        </form>
                        <form asp-action="Cancel" asp-route-id="@item.Id" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger" title="İptal Et">✘</button>
                        </form>
                    }

                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Sil">Sil</a>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
